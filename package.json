{
  "name": "tony-browser",
  "version": "0.11.0",
  "description": "Tony Browser — trình duyệt web thông minh có trợ lý AI",
  "main": "out/main/index.js",
  "build": {
    "appId": "com.tonybrowser.app",
    "productName": "Tony Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;WebBrowser",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --linux"
  },
  "author": "hungtvb",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.5.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "playwright": "^1.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
